# Where the documents live (relative paths resolve from this folder)
DOCS_DIR=./docs
# EMBED_MODEL=BAAI/bge-base-en-v1.5
# Reranks the vector search's top 25 down to the 6 sent to the LLM. Empty turns it off.
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Optional JSON merged into every chat request, for provider-specific switches.
# e.g. turn off Nemotron's reasoning (about 3x faster, but less careful about conflicting sources):
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# --- Option A: NVIDIA API (default) ---
NVIDIA_API_KEY=nvapi-xxxxxxxx
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Option B: Groq (fast hosted inference) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_xxxxxxxx
# LLM_MODEL=openai/gpt-oss-120b   (llama models need a paid plan)

# --- Option C: local Ollama ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b
